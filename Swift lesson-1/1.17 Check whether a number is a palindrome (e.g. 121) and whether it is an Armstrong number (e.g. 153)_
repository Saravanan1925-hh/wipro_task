let number = 153
var temp = number
var reverse = 0
var sum = 0

// Palindrome check
while temp > 0 {
    reverse = reverse * 10 + temp % 10
    temp /= 10
}

if reverse == number {
    print("Palindrome")
} else {
    print("Not palindrome")
}

// Armstrong check
temp = number

while temp > 0 {
    let digit = temp % 10
    sum += digit * digit * digit
    temp /= 10
}

if sum == number {
    print("Armstrong number")
} else {
    print("Not an Armstrong number")
}