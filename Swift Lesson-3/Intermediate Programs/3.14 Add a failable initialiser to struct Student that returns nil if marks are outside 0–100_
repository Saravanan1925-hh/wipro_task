struct Student {
    var name: String
    var marks: Int
    init?(name: String, marks: Int) {
        if marks < 0 || marks > 100 {
            return nil
        }

        self.name = name
        self.marks = marks
    }
}
if let s1 = Student(name: "Arun", marks: 85) {
    print("Student:", s1.name, s1.marks)
}
if let s2 = Student(name: "Bala", marks: 150) {
    print("Student:", s2.name, s2.marks)
} else {
    print("Invalid marks")
}